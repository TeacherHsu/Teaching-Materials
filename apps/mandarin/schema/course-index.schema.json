{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "國語課文樂園 — 課程索引契約 v1",
  "type": "object",
  "required": ["grades"],
  "properties": {
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["grade", "label", "volumes"],
        "properties": {
          "grade": { "type": "integer", "minimum": 1, "maximum": 6 },
          "label": { "type": "string" },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "publisher", "term", "label", "units"],
              "properties": {
                "code": { "type": "string", "pattern": "^\\d{3}[AB]G[1-6][HK]$" },
                "publisher": { "type": "string" },
                "term": { "type": "string", "enum": ["上", "下"] },
                "label": { "type": "string" },
                "reviews": {
                  "type": "array",
                  "description": "跨課統整複習（例：第 1～6 課綜合複習），掛在年級頁對應的課次區塊內",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "items"
                    ],
                    "properties": {
                      "from": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "to": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "title",
                            "url"
                          ],
                          "properties": {
                            "title": {
                              "type": "string",
                              "minLength": 1
                            },
                            "description": {
                              "type": "string"
                            },
                            "url": {
                              "type": "string",
                              "pattern": "^\\.\\./[A-Za-z0-9_./-]+/$",
                              "description": "站內相對路徑（相對於 /mandarin/），例如 ../Chinese/Shape-Run-G6A/"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["no", "title", "lessons"],
                    "properties": {
                      "no": { "type": "integer" },
                      "title": { "type": "string" },
                      "lessons": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["lesson_id", "lesson_no", "title", "data"],
                          "properties": {
                            "lesson_id": { "type": "string" },
                            "lesson_no": { "type": "integer" },
                            "title": { "type": "string" },
                            "data": {
                              "type": "string",
                              "description": "相對於 public/ 的 lesson JSON 路徑"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
