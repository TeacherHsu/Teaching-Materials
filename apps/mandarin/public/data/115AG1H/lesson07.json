  "main_idea": {
    "gist": "課文在山谷中描寫呼喊與回音的互相呼應，最後用笑聲表現分享的快樂。",
    "theme": "課文理解",
    "status": "approved",
    "source": "115G1A／翰林一年上官方教材（08課文結構表；公開版課文地圖摘要）"
  },
  "reading_questions": [
    {
      "id": "reading-question:115AG1H07:01",
      "stem": "仔細觀察課文插圖，主角和家人一起做什麼事情？",
      "answer_hint": "和家人一起爬山。",
      "strategy_tag": "提取訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:02",
      "stem": "主角爬山爬到哪裡，才開始大喊呢？",
      "answer_hint": "山谷。",
      "strategy_tag": "提取訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:03",
      "stem": "當主角大叫：「你好！」發生了什麼事？",
      "answer_hint": "聽到有人也回應他：「你好！」",
      "strategy_tag": "提取訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:04",
      "stem": "「我大叫：『你好！』有人回：『你好！』」課文中的「有人」是指誰？",
      "answer_hint": "我看課本第57頁插圖，覺得是山谷，因為山谷上有一張張的笑臉；我覺得因為課文是在講「回音」，所以「有人」就是主角自己傳回來的聲音。",
      "strategy_tag": "推論訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:05",
      "stem": "為什麼主角會再大叫一聲：「你開心嗎？」",
      "answer_hint": "因為想再確定是否還會有回音。",
      "strategy_tag": "推論訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:06",
      "stem": "你覺得課文中「有人」和「他」是同一人嗎？為什麼？",
      "answer_hint": "我覺得是同一人，都是指山谷的回音。",
      "strategy_tag": "比較評估",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:07",
      "stem": "為什麼「我笑，他也笑」呢？",
      "answer_hint": "因為在山谷，當主角笑的時候，就會傳回笑聲。",
      "strategy_tag": "推論訊息",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:08",
      "stem": "最後主角為什麼會笑了？",
      "answer_hint": "因為不論他喊什麼，都會傳回同樣的聲音，好像有人和他互動一樣，令人感覺驚喜。",
      "strategy_tag": "詮釋整合",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:09",
      "stem": "根據課文和插圖，再請你說說看什麼是「回音」？",
      "answer_hint": "「回音」就是當人的聲音碰到山或牆壁，會再傳回來。",
      "strategy_tag": "詮釋整合",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    },
    {
      "id": "reading-question:115AG1H07:10",
      "stem": "想一想，生活中哪些地方也容易產生回音？和課本中產生回音的原因有什麼相同之處？",
      "answer_hint": "生活中容易產生回音的地方有教室、禮堂、山洞等，都是空曠但是有圍起來的牆壁或山壁的地方。",
      "strategy_tag": "比較評估",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（09閱讀理解提問；使用者貼上之 L01-L07 教材內容；公開衍生資料）"
    }
