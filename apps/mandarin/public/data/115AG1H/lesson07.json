  "paragraph_summary": [
    {
      "id": "paragraph_summary:115AG1H07:01",
      "para_no": 1,
      "paragraph_no": 1,
      "summary": "起：爬上高山、來到山谷，交代回音出現的地方。",
      "structure_role": "開端",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（08課文結構表；公開版課文地圖摘要）"
    },
    {
      "id": "paragraph_summary:115AG1H07:02",
      "para_no": 2,
      "paragraph_no": 2,
      "summary": "承：我先大叫你好，山谷有人回應同樣的話。",
      "structure_role": "發展",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（08課文結構表；公開版課文地圖摘要）"
    },
    {
      "id": "paragraph_summary:115AG1H07:03",
      "para_no": 3,
      "paragraph_no": 3,
      "summary": "承：我問你開心嗎，對方也問相同問題。",
      "structure_role": "發展",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（08課文結構表；公開版課文地圖摘要）"
    },
    {
      "id": "paragraph_summary:115AG1H07:04",
      "para_no": 4,
      "paragraph_no": 4,
      "summary": "轉：我的笑聲得到回應。",
      "structure_role": "轉折",
      "status": "approved",
      "source": "115G1A／翰林一年上官方教材（08課文結構表；公開版課文地圖摘要）"
    },
    {
      "id": "paragraph_summary:115AG1H07:05",
      "para_no": 5,
      "paragraph_no": 5,
      "summary": "合：大家一起哈哈大笑，呈現回音互相呼應。",
      "structure_role": "收束",
