      "etymology": {
        "structure": "象形",
        "components": [
          {
            "part": "來",
            "role": "象形",
            "note": "像一株麥子，有麥穗和葉子"
          }
        ],
        "story": "「來」本來畫的是一株麥子，上面是麥穗，兩旁是葉子。古人說麥子是上天送來的，後來「來」就被借去表示「過來」的意思，本來的意思反而改用「麥」字。",
        "source": "《說文解字．來部》：「來，周所受瑞麥來麰…天所來也，故為行來之來。」",
        "status": "approved",
        "approved_by": "CF",
        "approved_on": "2026-10-01"
      }
    },
