  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:10:01",
      "paragraph_no": 1,
      "summary": "老朋友準備家常飯菜，邀請詩人到農莊做客。",
      "structure_role": "【第1～2句】受邀做客",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:10:02",
      "paragraph_no": 2,
      "summary": "翠綠的樹林圍繞村莊，青山在城外連綿。",
      "structure_role": "【第3～6句】田園景色與聚會",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:10:03",
      "paragraph_no": 3,
      "summary": "詩人推開窗戶，面對晒穀場和菜園。",
      "structure_role": "【第7～8句】再聚之約",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:10:04",
      "paragraph_no": 4,
      "summary": "他和老朋友舉杯暢飲，閒談農作物的生長情形。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:10:05",
      "paragraph_no": 5,
      "summary": "賓主盡歡，詩人對田園生活和友情意猶未盡。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:10:06",
      "paragraph_no": 6,
      "summary": "兩人約定重陽節再相聚，一起欣賞菊花。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
