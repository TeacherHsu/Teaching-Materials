  "paragraph_summary": [
    {
      "id": "paragraph:11:01",
      "paragraph_no": 1,
      "summary": "天冷的時候，作者特別想來一碗熱騰騰的羹湯。",
      "structure_role": "【第1段】天冷想喝羹湯",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:11:02",
      "paragraph_no": 2,
      "summary": "一碗羹湯讓人感到暖和，也想起熟悉的街巷。",
      "structure_role": "【第2段】羹湯的材料與做法",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:11:03",
      "paragraph_no": 3,
      "summary": "羹湯加入食材、醬料，再用芡粉勾芡。",
      "structure_role": "【第3段】一碗湯的溫暖",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:11:04",
      "paragraph_no": 4,
      "summary": "濃稠的湯汁包住食材，散發香氣。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:11:05",
      "paragraph_no": 5,
      "summary": "作者品嘗羹湯，感受到店家用心準備的溫暖。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:11:06",
      "paragraph_no": 6,
      "summary": "這碗羹湯不只是食物，也連結生活記憶與人情味。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
