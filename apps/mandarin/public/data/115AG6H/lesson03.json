  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:03:01",
      "paragraph_no": 1,
      "summary": "作者在杏樹林想像孔子在杏壇教學，帶出孔子的教育精神。",
      "structure_role": "【第一大意】孔子與教育",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:03:02",
      "paragraph_no": 2,
      "summary": "孔子重視有教無類與因材施教，讓不同學生都能學習。",
      "structure_role": "【第二大意】溫故知新",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:03:03",
      "paragraph_no": 3,
      "summary": "孔子說「溫故而知新」，複習舊知識可以得到新的理解。",
      "structure_role": "【第三大意】擇善改過",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:03:04",
      "paragraph_no": 4,
      "summary": "能從溫習中發現新意的人，可以成為別人的老師。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:03:05",
      "paragraph_no": 5,
      "summary": "孔子說三人同行一定有可學習的人，要選擇別人的優點跟隨。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:03:06",
      "paragraph_no": 6,
      "summary": "看到別人的缺點時，也要提醒自己改正，持續學習。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
  "main_idea": {
    "gist": "孔子用簡短話語提醒我們溫故知新、擇善改過，並向身邊的人學習。",
    "theme": "閱讀理解",
    "status": "approved",
    "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
  },
