  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:05:01",
      "paragraph_no": 1,
      "summary": "作者每天經過施工路段，車子走走停停；偶然從車窗看見一株美樹，急躁的心情霎時安靜下來。",
      "structure_role": "【觀樹第1～3段】發現美樹",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:05:02",
      "paragraph_no": 2,
      "summary": "作者觀察樹幹、枝椏和綠葉，覺得樹默默站在路邊，像在訴說堅強而漫長的故事。",
      "structure_role": "【觀樹第4～6段】樹與朋友",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:05:03",
      "paragraph_no": 3,
      "summary": "作者喜歡樹風姿多變，並把可靠、踏實、穩重的朋友比作樹；朋友在失意時給人支持，像樹蔭遮陽。",
      "structure_role": "【種樹第1～5段】種下並傳遞善意",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:05:04",
      "paragraph_no": 4,
      "summary": "作者慶幸樹沒有被砍去，每天清晨看見它，依稀覺得它像一位守候的摯友向自己道早安。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:05:05",
      "paragraph_no": 5,
      "summary": "作者想起校園的樹與好友送杏仁酥的事，明白種樹或善待他人，可能在無意間帶給別人喜悅。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:05:06",
      "paragraph_no": 6,
      "summary": "作者把閱讀和寫作比作享受與栽種綠蔭，期許在得到庇護時，也能為他人付出，讓美好傳遞下去。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
  "main_idea": {
    "gist": "作者先觀樹，從樹的沉穩想到可靠的朋友；再寫種樹，體會善意能像綠蔭一樣庇護他人，並期許自己把美好傳下去。",
    "theme": "閱讀理解",
