  "paragraph_summary": [
    {
      "id": "paragraph:04:01",
      "paragraph_no": 1,
      "summary": "人們觀察大自然的構造與現象，從中得到解決問題的靈感。",
      "structure_role": "【第一大意】自然啟發設計",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:04:02",
      "paragraph_no": 2,
      "summary": "仿生學就是模仿生物的特徵，設計出更方便或更有效的物品。",
      "structure_role": "【第二大意】三個仿生例子",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:04:03",
      "paragraph_no": 3,
      "summary": "蚊子的口器有鋸齒狀構造，啟發科學家設計較不痛的針頭。",
      "structure_role": "【第三大意】善用自然智慧",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:04:04",
      "paragraph_no": 4,
      "summary": "蓮葉表面的奈米結構能讓水珠滾落，啟發抗汙材料的設計。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:04:05",
      "paragraph_no": 5,
      "summary": "老鷹翅膀末端的羽毛能減少阻力，啟發飛機翼端的設計。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:04:06",
      "paragraph_no": 6,
      "summary": "只要仔細觀察與學習，大自然的智慧能讓生活更進步。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
