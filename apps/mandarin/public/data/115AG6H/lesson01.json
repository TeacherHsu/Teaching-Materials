  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:01:01",
      "paragraph_no": 1,
      "summary": "詩人站在生態池邊，看見水中倒影。風吹起漣漪，倒影變得皺巴巴，也讓他開始注意既熟悉又不確定的自己。",
      "structure_role": "【第一段】觀察自己",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:01:02",
      "paragraph_no": 2,
      "summary": "池旁葉縫透出的光，好像家人、師長和同學關注的小眼睛。詩人猶豫要扮鬼臉還是笑咪咪，展開自我省思。",
      "structure_role": "【第二段】探索自己",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:01:03",
      "paragraph_no": 3,
      "summary": "詩人詢問覓食的小魚：自己雖然熱情，卻常愛捉弄人，這樣能找到真摯友情嗎？他開始檢討與朋友相處的態度。",
      "structure_role": "【第三段】期勉自己",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:01:04",
      "paragraph_no": 4,
      "summary": "詩人詢問自由自在的蝴蝶：想學習又貪玩的自己，能否破蛹飛起、追尋夢想？蝴蝶象徵經歷挑戰後的成長。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:01:05",
      "paragraph_no": 5,
      "summary": "詩人再詢問耀眼的陽光：優點與缺點是上天註定，還是能由自己決定？他明白願意選擇與努力，就能改進不足。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:01:06",
      "paragraph_no": 6,
      "summary": "最後，詩人想摘下雪白的雲，擦亮誠懇的心靈，迎向太陽，把幽暗抹成光明，並把彩虹般的微笑儲存給未來的自己。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    }
  ],
  "main_idea": {
    "gist": "詩人藉池中倒影展開自我探索，省思友情、學習與特質，最後以正向積極態度追求光明的未來。",
    "theme": "閱讀理解",
    "status": "approved",
    "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
  },
