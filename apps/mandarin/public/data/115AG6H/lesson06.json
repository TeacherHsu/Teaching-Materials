  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:06:01",
      "paragraph_no": 1,
      "summary": "作者先說明幽默能讓人會心一笑、化解尷尬、營造良好談話氣氛，並提出最高明的幽默是自嘲。",
      "structure_role": "【第1～2段】提出觀點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:06:02",
      "paragraph_no": 2,
      "summary": "開玩笑若用挖苦或揶揄別人的方式，可能傷害他人、引起反感，使局勢僵持不下。",
      "structure_role": "【第3～5段】正例與使用原則",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:06:03",
      "paragraph_no": 3,
      "summary": "林肯被批評是雙面人時，以自己的長相開玩笑，引來觀眾笑聲，也化解對手的批判。",
      "structure_role": "【第6～8段】反例與結論",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:06:04",
      "paragraph_no": 4,
      "summary": "如果林肯惱羞成怒，可能錯失扭轉頹勢的機會；自嘲要適可而止，內容應是自己的缺點或弱點。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G6A／翰林六上官方教材與教師確認資料（12主旨、段落大意、13課文結構表）"
    },
    {
      "id": "paragraph:06:05",
      "paragraph_no": 5,
      "summary": "餐廳男人久候餐點，用像乞丐般不受重視來抱怨；這種自嘲透露對乞丐的成見，容易引起反感。",
