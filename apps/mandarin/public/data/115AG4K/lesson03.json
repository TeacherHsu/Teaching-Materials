    },
    {
      "id": "paragraph:115AG4K03:02",
      "paragraph_no": 2,
      "summary": "初次站上球場時，高高的球架像遙不可及的山，主角既害怕又不懂投球方法，只能先聽學長鼓勵。",
      "structure_role": "加入】夢想與害怕",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K03:03",
      "paragraph_no": 3,
      "summary": "學長用熟能生巧勉勵他多練習；開始運球時，球常反彈飛撞下巴，讓學習過程充滿挫折與挑戰。",
      "structure_role": "練習】挫折與進步",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K03:04",
      "paragraph_no": 4,
      "summary": "主角沒有放棄，每天提早到場反覆練習，逐漸學會控制籃球；當他投進籃時，終於感受運動的喜悅。",
      "structure_role": "練習】挫折與進步",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K03:05",
      "paragraph_no": 5,
      "summary": "比賽結束前只剩五秒，雙方分數相同；主角帶著同伴鼓勵上場，努力讓自己在緊張中保持冷靜。",
      "structure_role": "比賽】緊張與成就",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K03:06",
      "paragraph_no": 6,
      "summary": "他忘記四周喧鬧，深深吸氣後將球拋出，籃球沿著優美弧線飛向球框，最後進球並獲得全場喝采，證明持續努力能使夢想成真。",
      "structure_role": "比賽】緊張與成就",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
