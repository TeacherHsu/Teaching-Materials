  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K09:01",
      "paragraph_no": 1,
      "summary": "泰國因佛教文化深厚被稱為千佛之國，各地可見華麗安靜的泰國寺廟，形成重要的宗教景觀。",
      "structure_role": "泰國與埃及】宗教和古文明",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K09:02",
      "paragraph_no": 2,
      "summary": "信奉佛教的男子曾有出家當和尚的傳統，遊客也會逛水上市場，看船隻載著貨物熱鬧交易。",
      "structure_role": "泰國與埃及】宗教和古文明",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K09:03",
      "paragraph_no": 3,
      "summary": "埃及金字塔聞名世界，廣大沙漠雖然乾熱，尼羅河仍為城市和南北土地帶來珍貴水源。",
      "structure_role": "泰國與埃及】宗教和古文明",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K09:04",
      "paragraph_no": 4,
      "summary": "荷蘭部分國土低於海面，因此必須築堤防潮並利用風車排水，居民也發展出適應環境的生活方式。",
      "structure_role": "荷蘭與奧地利】環境和音樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K09:05",
      "paragraph_no": 5,
      "summary": "荷蘭盛產鬱金香與水仙；奧地利則以音樂聞名，許多作曲家曾居住，節慶時吸引各地遊客。",
      "structure_role": "荷蘭與奧地利】環境和音樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K09:06",
      "paragraph_no": 6,
      "summary": "四個國家各有自然環境、建築、宗教與藝術特色，作者用邀請語氣帶領讀者認識不同家鄉，也理解人們如何依環境創造生活方式的智慧。",
      "structure_role": "荷蘭與奧地利】環境和音樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
