  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K01:01",
      "paragraph_no": 1,
      "summary": "大家在游泳池自在前進，想像自己化成魚、青蛙和蝴蝶，在水中展現不同姿態，也感受身體活動的自由。",
      "structure_role": "游泳】想像、歡樂與自信",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K01:02",
      "paragraph_no": 2,
      "summary": "歡笑聲接連響起，晶亮的水珠一串串飛向空中，水花和笑聲彼此呼應，呈現熱鬧又快樂的游泳情景。",
      "structure_role": "游泳】想像、歡樂與自信",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K01:03",
      "paragraph_no": 3,
      "summary": "游泳讓大家建立堅定自信與遠大志向，也期待自己能勇敢前進，活出多采多姿而充滿希望的人生。",
      "structure_role": "游泳】想像、歡樂與自信",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K01:04",
      "paragraph_no": 4,
      "summary": "主角穿好裝備溜直排輪，風從耳旁吹過，眼前景物快速後退，速度感讓他覺得天地十分寬廣。",
      "structure_role": "溜直排輪】速度、動作與快樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K01:05",
      "paragraph_no": 5,
      "summary": "他想像自己成為飛鷹，在寬闊天地間滑行加速，感受迎風前進、自由移動和勇敢探索的快樂。",
      "structure_role": "溜直排輪】速度、動作與快樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K01:06",
      "paragraph_no": 6,
      "summary": "陽光與汗水陪伴他像陀螺般轉身跳躍，所有煩惱被風吹走，只留下緊緊跟隨自己的快樂心情，也更加喜愛迎風運動的感覺。",
      "structure_role": "溜直排輪】速度、動作與快樂",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
