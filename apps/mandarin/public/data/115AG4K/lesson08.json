  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K08:01",
      "paragraph_no": 1,
      "summary": "城市中居高臨下的大樓像建築界的長頸鹿，不只外形醒目，也具有重要功能並形成特有景觀。",
      "structure_role": "總說與臺北】高樓功能",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K08:02",
      "paragraph_no": 2,
      "summary": "台北一○一外形像竹節向上開展，象徵經濟高升；大樓上的古錢圖案也代表金融中心的角色。",
      "structure_role": "總說與臺北】高樓功能",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K08:03",
      "paragraph_no": 3,
      "summary": "建築內安裝大型阻尼器，可以減少強風吹動的搖晃並避免地震造成危險，跨年煙火也吸引世界目光。",
      "structure_role": "總說與臺北】高樓功能",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K08:04",
      "paragraph_no": 4,
      "summary": "東京晴空塔由三角形底部逐漸轉為圓形，白色塔身帶有青色光澤，外觀能融入遼闊藍天。",
      "structure_role": "東京與吉隆坡】外形特色",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K08:05",
      "paragraph_no": 5,
      "summary": "它原是改善城市收訊的電波通訊塔，後來結合都市開發，為周邊地區帶來觀光人潮與商業機會。",
      "structure_role": "東京與吉隆坡】外形特色",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K08:06",
      "paragraph_no": 6,
      "summary": "吉隆坡雙峰塔之間設有連通橋，方便人們往來；多功能高樓也讓旅客認識當地文化與城市特色，並留下難忘的城市印象。",
      "structure_role": "東京與吉隆坡】外形特色",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
