  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K05:01",
      "paragraph_no": 1,
      "summary": "海倫凱勒幼時因病失去視覺與聽覺，仍靠老師教導和自己的努力完成學業，成為鼓舞世界的勵志人物。",
      "structure_role": "人物】生命經歷與體會",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K05:02",
      "paragraph_no": 2,
      "summary": "她認為短暫失去感官能使人更珍惜光明，黑暗讓人懂得看見的可貴，寧靜也讓聲音顯得更加悅耳。",
      "structure_role": "人物】生命經歷與體會",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K05:03",
      "paragraph_no": 3,
      "summary": "她詢問擁有正常視力的朋友在森林看見什麼，朋友卻說沒有特別發現，這個回答使她十分驚訝。",
      "structure_role": "感受】觸覺發現世界",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K05:04",
      "paragraph_no": 4,
      "summary": "她單憑觸覺就能發現許多事物，例如摸到枝頭的春天蓓蕾，也能感受鳥鳴、流水和陽光的溫暖。",
      "structure_role": "感受】觸覺發現世界",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K05:05",
      "paragraph_no": 5,
      "summary": "草地像柔軟地毯般舒適，她由指尖感受自然；因此無法理解看得見的人為何忽略眼前美麗景色。",
      "structure_role": "省思】珍惜所見幸福",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K05:06",
      "paragraph_no": 6,
      "summary": "她渴望親眼看見五彩繽紛的世界；若能擁有三天光明，一定會盡力觀看並珍惜看得見的幸福，也提醒人們別把每天能看見的一切視為理所當然。",
      "structure_role": "省思】珍惜所見幸福",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
