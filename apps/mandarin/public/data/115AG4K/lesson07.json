  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K07:01",
      "paragraph_no": 1,
      "summary": "美食作家先介紹印度甩餅，師傅把餅皮拍打並向空中拋，使原本小小的麵皮逐漸變得又大又薄。",
      "structure_role": "印度】甩餅製作與口感",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K07:02",
      "paragraph_no": 2,
      "summary": "餅皮烙過後可以沾些咖哩，也能包入不同食材和醬料，入口柔軟，呈現印度料理的獨特風味。",
      "structure_role": "印度】甩餅製作與口感",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K07:03",
      "paragraph_no": 3,
      "summary": "她接著介紹造型多變的義大利麵，說明紅醬酸甜、濃郁白醬柔和，以及青醬香氣等不同口味。",
      "structure_role": "義大利與日本】料理特色",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K07:04",
      "paragraph_no": 4,
      "summary": "最後全班動手製作日本壽司，把喜歡的材料加入醋飯，再用工具完成料理並分享親手做的成果。",
      "structure_role": "義大利與日本】料理特色",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K07:05",
      "paragraph_no": 5,
      "summary": "巧文姐姐喜歡用味覺探索不同國度，大家也從影片、說明和實作中認識各地飲食與生活文化。",
      "structure_role": "收穫】用味覺探索文化",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K07:06",
      "paragraph_no": 6,
      "summary": "這堂課充滿驚嘆與喜悅，學生不只吃到料理，也理解食物能記錄旅行經驗，成為難忘的學習，並發現每道料理背後都有文化故事。",
      "structure_role": "收穫】用味覺探索文化",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
