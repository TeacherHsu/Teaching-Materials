  "words": [
    {
      "id": "word:115AG4K07:01",
      "word": "咖哩",
      "zhuyin": "ㄎㄚㄌㄧˇ",
      "meaning": "用胡椒、薑黃、番椒、茴香、陳皮等粉末製成的調味品。色黃、味香而辛辣，以印度所產的咖哩最著名。",
      "example_sentence": null,
      "example_status": "todo_rewrite",
      "level": "basic",
      "image": "/assets/115AG4K/lesson07/vocabulary/l07-01.webp",
      "status": "ready",
      "source": "康軒官方教材來源整理（05 詞語解釋及例句）"
    },
    {
      "id": "word:115AG4K07:02",
      "word": "印度",
      "zhuyin": "ㄧㄣˋㄉㄨˋ",
      "meaning": "國名。位於亞洲南部，介於孟加拉灣與阿拉伯海之間，為世界文明古國之一。首都為新德里。人民信仰的宗教有印度教、基督教等。主要語言為北印度語、英語。原為英國殖民地，西元一九四七年正式獨立。",
      "example_sentence": null,
      "example_status": "todo_rewrite",
      "level": "basic",
      "image": "/assets/115AG4K/lesson07/vocabulary/l07-02.webp",
      "status": "ready",
      "source": "康軒官方教材來源整理（05 詞語解釋及例句）"
    },
    {
      "id": "word:115AG4K07:03",
      "word": "甩餅",
      "zhuyin": "ㄕㄨㄞˇㄅㄧㄥˇ",
      "meaning": "印度甩餅，是馬來西亞 印度裔發明的食物。做法是將和好的小片麵皮，多次旋轉向上拋甩，形成大而薄的圓餅，再放到鍋上烙。",
      "example_sentence": null,
      "example_status": "todo_rewrite",
      "level": "basic",
      "image": "/assets/115AG4K/lesson07/vocabulary/l07-03.webp",
      "status": "ready",
      "source": "康軒官方教材來源整理（05 詞語解釋及例句）"
    },
    {
