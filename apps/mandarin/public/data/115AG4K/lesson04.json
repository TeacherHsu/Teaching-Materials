  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K04:01",
      "paragraph_no": 1,
      "summary": "來自加拿大的馬偕完成神學與醫學訓練後，自願前往海外服務，並決定把自己的能力帶到臺灣。",
      "structure_role": "來臺】立定服務志向",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K04:02",
      "paragraph_no": 2,
      "summary": "抵達臺灣後，他下定決心奉獻一生，關心居民生活與健康，希望用實際行動幫助需要照顧的人。",
      "structure_role": "來臺】立定服務志向",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K04:03",
      "paragraph_no": 3,
      "summary": "當時醫療條件落後，疾病容易流行；他陪居民清水溝、除草，並宣導保持居家衛生的重要。",
      "structure_role": "行動】改善醫療衛生",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K04:04",
      "paragraph_no": 4,
      "summary": "他主動發放藥品、邀請醫師協助，許多人為了求助而翻山越嶺前來，逐漸得到治病與照顧的機會。",
      "structure_role": "行動】改善醫療衛生",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K04:05",
      "paragraph_no": 5,
      "summary": "善心人士認同他的付出而捐錢支持，他因此興建醫院、創辦學校，也設立讓女子學習的女學堂。",
      "structure_role": "貢獻】醫院、教育與精神",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K04:06",
      "paragraph_no": 6,
      "summary": "他長期走訪城鄉、照顧人民，把青春和愛留在臺灣；服務、教育與關懷的精神也一直流傳至今，後人仍記得他對健康與教育的長久貢獻。",
      "structure_role": "貢獻】醫院、教育與精神",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
