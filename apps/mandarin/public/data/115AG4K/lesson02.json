  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K02:01",
      "paragraph_no": 1,
      "summary": "作者放學後飛快趕回家，桌上的美味像在點心招手，有時還能喝到香甜柔軟、令人期待的紅豆湯。",
      "structure_role": "回家】點心與好友",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K02:02",
      "paragraph_no": 2,
      "summary": "好友來家裡一起寫功課，大家卻抵擋不了食物香氣，常把作業拋到腦後，先將眼前點心吃得一乾二淨。",
      "structure_role": "回家】點心與好友",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K02:03",
      "paragraph_no": 3,
      "summary": "國語日報是作者重要的精神食糧，他和姐姐看報時曾爭著先讀，後來想出分看左右面與正反面的好方法。",
      "structure_role": "活動】閱讀與遊戲",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K02:04",
      "paragraph_no": 4,
      "summary": "完成作業後，大家到公園玩警察抓小偷，也一起比賽跳繩，人人奮勇爭先，享受追跑和競賽的樂趣。",
      "structure_role": "活動】閱讀與遊戲",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K02:05",
      "paragraph_no": 5,
      "summary": "太陽快下山時，大人呼喊孩子回家吃飯，大家才依依不捨結束活動，告別共同遊玩的朋友和公園。",
      "structure_role": "感受】留戀幸福時光",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K02:06",
      "paragraph_no": 6,
      "summary": "作者喜歡吃點心、看報紙與玩遊戲，覺得放學時間過得特別快，希望幸福快樂的時光能長久停留。",
      "structure_role": "感受】留戀幸福時光",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
