  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K06:01",
      "paragraph_no": 1,
      "summary": "臺灣登山家江秀真站在雪山前開朗笑著，她成功登上世界多座高峰，被人稱為最接近天空的女子。",
      "structure_role": "夢想】登山家的目標",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K06:02",
      "paragraph_no": 2,
      "summary": "她是臺灣第一位登上珠穆朗瑪峰的女性，熱愛高山，感覺沉靜的山像母親一樣擁抱並陪伴自己。",
      "structure_role": "夢想】登山家的目標",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K06:03",
      "paragraph_no": 3,
      "summary": "高山有時帶來溫暖，有時也用嚴寒與困難冷酷磨練她；登頂美景則使她感到歡樂與自我實現。",
      "structure_role": "準備】磨練與訓練",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K06:04",
      "paragraph_no": 4,
      "summary": "她決定攀登高峰，每天跑步並進行每週三天的低氧訓練，長期準備後正式朝最高目標出發。",
      "structure_role": "準備】磨練與訓練",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K06:05",
      "paragraph_no": 5,
      "summary": "途中寒風呼嘯、溫差劇烈，她還冒著跌落谷底的危險緩慢前進，最後路段成為最大的生命考驗。",
      "structure_role": "挑戰】危險、堅持與成功",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K06:06",
      "paragraph_no": 6,
      "summary": "體力耗盡時，成功畫面鼓舞她排除難關；她靠勇氣與決心登頂，也繼續面對人生中的每座高山，並鼓勵人們不要讓夢想只停在空想。",
      "structure_role": "挑戰】危險、堅持與成功",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
