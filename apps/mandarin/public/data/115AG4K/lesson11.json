  "paragraph_summary": [
    {
      "id": "paragraph:115AG4K11:01",
      "paragraph_no": 1,
      "summary": "愛麗絲看見穿鵝黃背心、手拿懷錶的兔子先生，因為好奇一路追趕，離開姐姐身邊展開奇遇。",
      "structure_role": "追兔子】進入奇異世界",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K11:02",
      "paragraph_no": 2,
      "summary": "她不小心掉進兔子洞，在深不見底的通道後來到許多門前，發現門全被鎖住而無法離開。",
      "structure_role": "追兔子】進入奇異世界",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K11:03",
      "paragraph_no": 3,
      "summary": "三腳桌告訴她可以用金鑰匙開門，但門太小，愛麗絲雖然打開入口，身體仍然無法通過。",
      "structure_role": "找方法】縮小與變大",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K11:04",
      "paragraph_no": 4,
      "summary": "她決定喝下果汁，身體縮小後卻把鑰匙留在高處；為了拿到它，又嘗試吃蛋糕讓自己變大。",
      "structure_role": "找方法】縮小與變大",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K11:05",
      "paragraph_no": 5,
      "summary": "她從桌邊小盒子找到蛋糕，先推想可能結果再勇敢嘗試，卻長得太高，只能繼續尋找方法。",
      "structure_role": "解決】恢復原形再出發",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    },
    {
      "id": "paragraph:115AG4K11:06",
      "paragraph_no": 6,
      "summary": "兔子先生慌張掉下扇子，愛麗絲搖動後恢復原形，於是再次追上兔子並踏上新的奇幻旅程；過程中她運用大膽假設與親自嘗試，一次次成功解決難題。",
      "structure_role": "解決】恢復原形再出發",
      "status": "approved",
      "source": "康軒官方教材來源整理（14 課文大意、段落大意）"
    }
  ],
