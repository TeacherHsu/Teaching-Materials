  "paragraph_summary": [
    {
      "id": "paragraph_summary:115AG3H06:1",
      "para_no": 1,
      "summary": "課本和作業處處可見鉛筆留下的字，課文從日常用品提出問題，帶領讀者認識它的原料、種類與製作過程。",
      "structure_role": "引起問題",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H06:2",
      "para_no": 2,
      "summary": "鉛筆不是用鉛做成，主要材料包括石墨、黏土和木頭；其中最重要的部分是能在紙上留下痕跡的筆芯。",
      "structure_role": "主要原料",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H06:3",
      "para_no": 3,
      "summary": "原料混合加工後形成光滑油亮的芯條，但直接拿來書寫容易斷裂，也會把手弄黑，因此需要木板提供保護。",
      "structure_role": "筆芯問題",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H06:4",
      "para_no": 4,
      "summary": "機器先在木板刻出一道道凹槽，放入細芯後再黏上另一片木板，做成像三明治般的長條材料。",
      "structure_role": "製作筆桿",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H06:5",
      "para_no": 5,
      "summary": "接著材料被切成一枝枝筆桿並上色；有些自動鉛筆不用削，只要按壓就能讓新的芯露出來繼續書寫。",
      "structure_role": "自動鉛筆",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H06:6",
      "para_no": 6,
      "summary": "色鉛筆不含黑色原料，而是加入顏料畫出各種色彩；了解這些學問後，作者提醒大家愛惜使用每一枝鉛筆。",
      "structure_role": "色鉛筆與提醒",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    }
  ],
