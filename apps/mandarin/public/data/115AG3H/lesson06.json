  "listening": [
    {
      "id": "listening:115AG3H06:1",
      "stem": "鉛筆不是用鉛做成的，主要材料包括石墨、黏土和木頭。",
      "question": "鉛筆的主要材料不包括哪一項？",
      "options": [
        "石墨",
        "黏土",
        "鉛塊"
      ],
      "answer": "鉛塊",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（教師自撰聆聽題）"
    },
    {
      "id": "listening:115AG3H06:2",
      "stem": "直接拿筆芯書寫，筆芯容易斷裂，也可能把手弄黑，所以需要木板保護。",
      "question": "為什麼筆芯需要木板保護？",
      "options": [
        "避免斷裂和弄髒手",
        "讓筆芯變成彩色",
        "讓機器停止運轉"
      ],
      "answer": "避免斷裂和弄髒手",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（教師自撰聆聽題）"
    },
    {
      "id": "listening:115AG3H06:3",
      "stem": "機器在木板上刻出凹槽，放入細芯，再黏上另一片木板，做成長條材料。",
      "question": "機器先在木板上做什麼？",
      "options": [
        "刻出凹槽",
        "塗上顏色",
        "削尖筆芯"
      ],
      "answer": "刻出凹槽",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（教師自撰聆聽題）"
    },
    {
      "id": "listening:115AG3H06:4",
      "stem": "有些自動鉛筆不用削，只要輕輕按壓，就能讓新的筆芯露出來繼續書寫。",
      "question": "自動鉛筆如何讓新的筆芯露出來？",
      "options": [
        "輕輕按壓",
        "放入水中",
        "撕開筆桿"
      ],
      "answer": "輕輕按壓",
      "status": "approved",
      "source": "115G3A／翰林三上第6課官方教材與教師確認資料（教師自撰聆聽題）"
    }
  ],
