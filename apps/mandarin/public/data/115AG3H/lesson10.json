  "rhetoric": [],
  "paragraph_summary": [
    {
      "id": "paragraph:115AG3H:10:01",
      "paragraph_no": 1,
      "summary": "魯凱婚禮中，新娘穿著族服站上秋千，新郎一次次拉動繩索；秋千盪得越高，就代表新娘越勇敢。",
      "structure_role": "第1段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:10:02",
      "paragraph_no": 2,
      "summary": "新娘身上的百合花頭飾和其他飾品發出清脆聲音，笑容像花朵，現場歡呼也讓儀式顯得格外熱鬧。",
      "structure_role": "第2段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:10:03",
      "paragraph_no": 3,
      "summary": "作者第一次參加這樣的婚禮，覺得一切很新奇；會場響起歌聲，親友以歡笑和掌聲送上心意。",
      "structure_role": "第3段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:10:04",
      "paragraph_no": 4,
      "summary": "盪秋千結束後，新人先喝連杯酒，再逐一向親友敬酒；大家手拉著手唱歌跳舞，共同祝福新人。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:10:05",
      "paragraph_no": 5,
      "summary": "活動中還穿插藏新娘的習俗，男方必須帶著親友到部落裡尋找，過程充滿互助合作和歡樂氣氛。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:10:06",
      "paragraph_no": 6,
      "summary": "這項安排希望男方更加珍惜新娘，也表現魯凱族愛家互助的傳統精神；婚禮直到深夜才畫下句點，也讓參與者理解儀式背後的文化意義。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    }
  ],
