  "paragraph_summary": [
    {
      "id": "paragraph_summary:115AG3H04:1",
      "para_no": 1,
      "summary": "安靜的山腳下有一間小食堂，門前的風鈴會在風吹時發出清亮聲音。",
      "structure_role": "情境",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H04:2",
      "para_no": 2,
      "summary": "食堂由師徒分工，師傅負責燒水做菜，徒弟康康平時到外面撿柴。",
      "structure_role": "情境",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H04:3",
      "para_no": 3,
      "summary": "康康看見鍋子裡的水不停冒泡，師傅正在接待客人，他慌張地想辦法。",
      "structure_role": "嘗試",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H04:4",
      "para_no": 4,
      "summary": "康康使用揚湯止沸的方法，但水仍持續沸騰，師傅提醒他先思考原因。",
      "structure_role": "嘗試",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H04:5",
      "para_no": 5,
      "summary": "師傅抽出鍋底的柴火，火勢變小，滾水也跟著停止沸騰。",
      "structure_role": "領悟",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H04:6",
      "para_no": 6,
      "summary": "師傅教康康先找到問題的根本，再採取方法解決，這種做法叫釜底抽薪。",
      "structure_role": "領悟",
      "status": "approved",
      "source": "115G3A／翰林三上第4課官方教材與教師確認資料（12、13段落大意與課文結構表，重述版）"
    }
  ],
  "main_idea": {
    "id": "main_idea:115AG3H04:01",
    "gist": "課文透過康康先後嘗試揚湯止沸、師傅抽柴解決沸水的過程，說明處理問題要先找到根本原因，再採取有效方法。",
    "theme": "遇到問題先找根本，再想辦法解決。",
    "status": "approved",
    "source": "115G3A／翰林三上第4課官方教材與教師確認資料（主旨重述版）"
  },
