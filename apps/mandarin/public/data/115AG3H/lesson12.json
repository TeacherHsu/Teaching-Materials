  "paragraph_summary": [
    {
      "id": "paragraph:115AG3H:12:01",
      "paragraph_no": 1,
      "summary": "除夕團圓夜，車窗外雨絲不停，路上好像只剩下作者一家；他默默看時間，只盼趕快見到嬸嬸和親人。",
      "structure_role": "第1段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:12:02",
      "paragraph_no": 2,
      "summary": "車子抵達爺爺家後，大家匆忙上樓，奶奶開門迎接；小客廳雖然擁擠，卻因親人齊聚而十分溫暖。",
      "structure_role": "第2段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:12:03",
      "paragraph_no": 3,
      "summary": "嬸嬸在月子中心休息，爺爺提議用視訊問候；平板畫面讓分隔兩地的家人仍能在年夜飯時見面。",
      "structure_role": "第3段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:12:04",
      "paragraph_no": 4,
      "summary": "叔叔嬸嬸從畫面另一端拜年，鏡頭也拍到剛出生的小堂妹；爸爸提起車子故障，逗得全家一起大笑。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:12:05",
      "paragraph_no": 5,
      "summary": "奶奶隔著畫面送出小娃娃的第一份壓歲錢，爺爺也對這場透過科技完成的不一樣團聚感到滿足。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:12:06",
      "paragraph_no": 6,
      "summary": "叔叔握著嬸嬸的手說家人在哪裡，家就在那裡；煙火照亮夜空，所有人的臉上都露出幸福笑容，也體會真心相連就能跨越距離。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    }
  ],
