  "paragraph_summary": [
    {
      "id": "paragraph_summary:115AG3H02:633060cc",
      "para_no": 1,
      "summary": "小真升上三年級後仍常忘東忘西，做事慢吞吞，也記不住有哪些事情尚未完成。",
      "structure_role": "困擾",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H02:c5f23b62",
      "para_no": 2,
      "summary": "爸爸教她使用便利貼，把要做的事和完成時間記下來，再貼在明顯的位置。",
      "structure_role": "困擾",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H02:0fa500cd",
      "para_no": 3,
      "summary": "媽媽隔天要開會，全家必須準時出門；小真把任務貼在書桌前，完成一件事就打勾，睡前還設定鬧鐘。",
      "structure_role": "嘗試",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H02:45646966",
      "para_no": 4,
      "summary": "第二天大家果然在七點前出門，小真發現這個方法很有效，也知道逐項檢查能減少匆忙和遺漏。",
      "structure_role": "嘗試",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H02:6081273b",
      "para_no": 5,
      "summary": "她開始更常運用便利貼，做事變得有次序，不但能按時完成計畫，也逐漸學會安排時間。",
      "structure_role": "改變",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H02:5536e42c",
      "para_no": 6,
      "summary": "她後來把便條貼在冰箱，提醒爸爸帶她做視力檢查；便利貼也成為關心並提醒家人的方法。",
      "structure_role": "改變",
      "status": "approved",
      "source": "115G3A／翰林三上第2課官方教材與教師確認資料（段落大意資料，重述版）"
    }
  ],
  "main_idea": {
    "id": "main_idea:115AG3H02:a60e2cec",
    "gist": "課文說明便利貼能幫助人記住事情、安排次序，讓生活變得更有條理。",
    "theme": "學會先規畫，再依照順序完成每天要做的事情。",
    "status": "approved",
    "source": "115G3A／翰林三上第2課官方教材與教師確認資料（主旨重述版）"
  },
