  "paragraph_summary": [
    {
      "id": "paragraph_summary:115AG3H03:1",
      "para_no": 1,
      "summary": "爸爸做了小統計，發現櫻櫻三天內接連弄丟公車票、筆、三角板和作業本，這些遺失都和做事過度匆忙有關。",
      "structure_role": "發現",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H03:2",
      "para_no": 2,
      "summary": "每天到了該上學的時候，櫻櫻才慌張尋找用品並大聲呼喊；她常在最後一刻行動，所以容易忘記重要物品。",
      "structure_role": "發現",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H03:3",
      "para_no": 3,
      "summary": "爸爸曾提醒她睡前整理明天要帶的書本和文具，她卻總回答到時候再說，沒有預先完成準備和檢查。",
      "structure_role": "分析",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H03:4",
      "para_no": 4,
      "summary": "爸爸進一步分析情況，指出問題不只是動作慢，而是做事缺乏計畫；總把事情拖到最後，自然容易來不及。",
      "structure_role": "分析",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H03:5",
      "para_no": 5,
      "summary": "他分享自己的方法：先想好要做的事，提前開始並把所需物品準備好，即使發現遺漏也還有時間處理。",
      "structure_role": "方法",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    },
    {
      "id": "paragraph_summary:115AG3H03:6",
      "para_no": 6,
      "summary": "爸爸希望櫻櫻學會先準備好，再提早五分鐘行動；只要不趕時間，就能降低錯誤，做事也會更從容。",
      "structure_role": "方法",
      "status": "approved",
      "source": "115G3A／翰林三上第3課官方教材與教師確認資料（段落大意資料，重述版）"
    }
  ],
  "main_idea": {
    "id": "main_idea:115AG3H03:01",
    "gist": "課文透過櫻櫻常常匆忙遺漏物品的情況，說明先計畫、先準備，再提早五分鐘行動，做事就能更從容。",
    "theme": "做事前先計畫和整理，提早準備可以減少遺漏。",
    "status": "approved",
    "source": "115G3A／翰林三上第3課官方教材與教師確認資料（主旨重述版）"
  },
