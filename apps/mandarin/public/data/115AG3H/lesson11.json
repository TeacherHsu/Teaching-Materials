  "paragraph_summary": [
    {
      "id": "paragraph:115AG3H:11:01",
      "paragraph_no": 1,
      "summary": "除夕那天，作者一家急著回南部過年，也想探望嬸嬸；天黑後，煙火鞭炮已響起，他們卻仍在返鄉路上。",
      "structure_role": "第1段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:11:02",
      "paragraph_no": 2,
      "summary": "車子突然傳出一陣怪聲，爸爸趕緊停靠路邊；附近店家大多休息，家人擔心無法及時回家團聚。",
      "structure_role": "第2段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:11:03",
      "paragraph_no": 3,
      "summary": "媽媽發現一家修車廠，師傅正準備關門吃年夜飯，爸爸立刻上前求助，希望有人協助處理故障。",
      "structure_role": "第3段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:11:04",
      "paragraph_no": 4,
      "summary": "師傅答應檢查車子並拖進廠內；即使家中圓桌已擺滿年菜，他和家人仍體諒旅人還有長路要趕。",
      "structure_role": "第4段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:11:05",
      "paragraph_no": 5,
      "summary": "幸好只有小零件損壞，師傅很快完成修理；家人的焦急得到化解，也感受到陌生人在節日中的善意。",
      "structure_role": "第5段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    },
    {
      "id": "paragraph:115AG3H:11:06",
      "paragraph_no": 6,
      "summary": "作者一家誠心道謝並祝對方新年快樂，師傅一家也回以一路平安的祝福，讓節日旅程留下溫暖回憶，也見證陌生人之間的善意。",
      "structure_role": "第6段重點",
      "status": "approved",
      "source": "115G3A／翰林官方教材（段落大意）"
    }
  ],
