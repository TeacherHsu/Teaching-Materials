{
  "name": "mandarin-lesson-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "國小國語數位教材網站（data-driven，取代 lesson-park 單檔 HTML 母版方案）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/filter-build-data.mjs",
    "build:preview": "vite build --outDir dist-preview && node scripts/filter-preview-data.mjs",
    "preview": "vite preview",
    "preview:draft": "vite preview --outDir dist-preview",
    "validate": "node scripts/validate-data.mjs && npm run check-text-leak",
    "check-workflow": "node scripts/check-workflow-completeness.mjs",
    "materialize:g1a": "node scripts/materialize-g1a-content.mjs",
    "materialize:lesson-focus": "node scripts/materialize-lesson-focus.mjs",
    "materialize:g3a-vocabulary": "python scripts/materialize-g3a-vocabulary.py",
    "materialize:g4a-l09-pasted": "node scripts/apply-pasted-g4a-l09-sentence-patterns.mjs",
    "materialize:g4a-reading-choices": "node scripts/materialize-g4a-reading-choices.mjs",
    "materialize:reading-answer-keys": "node scripts/materialize-reading-answer-keys.mjs",
    "check:polyphones-availability": "node scripts/test-polyphones-availability.mjs",
    "materialize:g6a-pasted": "node scripts/apply-pasted-g6a-sentence-patterns.mjs",
    "audit:listening": "node scripts/audit-listening-content.mjs",
    "backfill:listening": "node scripts/backfill-listening-passages.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "check-dist": "node scripts/check-dist.mjs && npm run check-assets",
    "build-char-index": "node scripts/build-char-index.mjs",
    "check-text-leak": "node scripts/check-text-leak.mjs",
    "review": "vite --open '/?preview=1#/'"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "vite": "^5.4.10"
  }
}
